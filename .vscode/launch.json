{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Play game",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${config:godotTools.editorPath.godot4}",
			"args": ["--path", "${workspaceFolder}"],
			"cwd": "${workspaceFolder}",
			"stopAtEntry": false,
			"console": "internalConsole"
		},
		{
			"name": "Open Godot editor",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${config:godotTools.editorPath.godot4}",
			"args": ["--path", "${workspaceFolder}", "--editor"],
			"cwd": "${workspaceFolder}",
			"stopAtEntry": false,
			"console": "internalConsole"
		}
	]
}
